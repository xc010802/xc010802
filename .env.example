# .env.example - 示例环境变量（不要将真实凭证提交到代码仓库）
# 复制为 .env 并填入你的真实值（.env 已被列入 .gitignore）

# Node / Nuxt
NODE_ENV=development
PORT=3001

# JWT
JWT_SECRET=your-super-secret-key-change-in-production

# SMTP（用于发送验证码）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@example.com   # 发件邮箱
SMTP_PASS=your_smtp_authorization_code  # SMTP/POP3/IMAP 授权码（非邮箱登录密码）

# 其他可选配置
# LIBSQL 或 数据库相关连接（如使用外部数据库）
# DATABASE_URL=

# 本地开发时（如果想在开发环境强制发送真实邮件）
# FORCE_SEND_REAL_EMAIL=false
